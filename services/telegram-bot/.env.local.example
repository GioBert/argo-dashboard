# Configurazione locale del bot Telegram per ARGO_DASHBOARD
#
# Uso consigliato:
# 1. copia questo file in `services/telegram-bot/.env.local`
# 2. inserisci i valori reali solo in `.env.local`
# 3. non salvare i segreti reali nel repository
#
# Il file `.env.local` e' gia' coperto dal `.gitignore` alla radice del progetto.


# -----------------------------------------------------------------------------
# Sezione 1: comportamento generale del servizio
# -----------------------------------------------------------------------------

# Ambiente di esecuzione.
# Valori tipici: development, production
NODE_ENV=development

# Fuso orario usato per il calcolo di oggi/domani/dopodomani e per lo scheduler.
# Per il tuo contesto lasciare normalmente `Europe/Rome`.
TZ=Europe/Rome

# Orario giornaliero di invio automatico nel gruppo Telegram.
# Formato consigliato: HH:mm a 24 ore.
# Esempio: 18:30
DAILY_REPORT_TIME=18:30


# -----------------------------------------------------------------------------
# Sezione 2: bot Telegram
# -----------------------------------------------------------------------------

# Token del bot Telegram ottenuto da BotFather.
# Esempio formato: 123456789:AA...
# Questo e' un segreto: non condividerlo.
TELEGRAM_BOT_TOKEN=

# ID numerico della chat o del gruppo autorizzato a ricevere i messaggi del bot.
# Per i gruppi spesso e' negativo e inizia con -100...
# Esempio: -1001234567890
TELEGRAM_ALLOWED_CHAT_IDS=


# ID numerici degli utenti Telegram amministratori autorizzati ai comandi sensibili.
# Se piu' di uno, separali con virgola senza spazi.
# Esempio: 123456789,987654321
TELEGRAM_ADMIN_USER_IDS=

# Se vuoi distinguere in futuro le chat che possono solo leggere da quelle che
# possono anche forzare un refresh, questo campo puo' restare uguale agli admin.
# Se non usato subito, puo' essere lasciato vuoto.
# Esempio: 123456789
TELEGRAM_REFRESH_USER_IDS=


# -----------------------------------------------------------------------------
# Sezione 3: accesso ad Argo
# -----------------------------------------------------------------------------

# Username Argo dell'account da usare per leggere i dati scolastici.
# Questo e' un segreto.
ARGO_USERNAME=

# Password Argo dell'account da usare per leggere i dati scolastici.
# Questo e' un segreto.
ARGO_PASSWORD=

# Codice scuola Argo.
# Non sempre e' "segreto" nello stesso senso della password, ma trattalo comunque
# come dato riservato di configurazione.
ARGO_SCHOOL_CODE=


# -----------------------------------------------------------------------------
# Sezione 4: cifratura locale e stato del bot
# -----------------------------------------------------------------------------

# Chiave usata dal servizio per cifrare eventuali dati persistiti localmente
# come cache, stato dell'ultimo invio o token riutilizzabili.
#
# Requisiti pratici consigliati:
# - stringa lunga
# - casuale
# - almeno 32 caratteri
# - diversa dalle altre password
#
# Esempio: genera una chiave casuale e incollala qui.
# Questo e' un segreto critico.
ARGO_SECRET_KEY=

# Percorso del file di stato locale del bot.
# In sviluppo puo' restare relativo alla cartella del servizio.
# In produzione e' meglio montarlo su volume Docker dedicato.
# Esempio: ./data/state.json
BOT_STATE_PATH=./data/state.json


# -----------------------------------------------------------------------------
# Sezione 5: logging e sicurezza operativa
# -----------------------------------------------------------------------------

# Livello di log.
# Valori tipici: debug, info, warn, error
# In produzione consigliato: info
LOG_LEVEL=info

# Se impostato a `true`, il bot puo' scegliere di non inviare di nuovo un report
# giornaliero se il contenuto dei compiti non e' cambiato rispetto all'ultimo invio.
# Valori ammessi: true, false
SKIP_DUPLICATE_REPORTS=true

# Timeout massimo per le chiamate di rete verso Argo, in millisecondi.
# Esempio: 15000
ARGO_HTTP_TIMEOUT_MS=15000

# Numero massimo di tentativi per una sincronizzazione fallita.
# Esempio: 2
ARGO_MAX_RETRIES=2


# -----------------------------------------------------------------------------
# Sezione 6: note operative personali
# -----------------------------------------------------------------------------

# Spazio libero per promemoria locali.
# Esempio:
# BOT_NOTES=Gruppo famiglia principale
BOT_NOTES=
